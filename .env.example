# Supabase Configuration (Required for cloud sync & user stats)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Server Port (Optional, defaults to 5000; automatically assigned by cloud providers)
PORT=5000

# Node Environment (production / development)
NODE_ENV=production

# CORS Allowed Origins (Optional: comma-separated list of allowed domains or wildcards)
# Example: ALLOWED_ORIGINS=https://your-app.vercel.app,https://*.onrender.com
ALLOWED_ORIGINS=

# Custom Frontend URL (Optional: single origin allowed for CORS)
FRONTEND_URL=

# Frontend API URL (Only needed if frontend static files are hosted separately from backend)
# VITE_API_URL=https://your-backend-api.onrender.com
